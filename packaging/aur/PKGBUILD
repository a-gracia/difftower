# Maintainer: a-gracia <https://github.com/a-gracia>
# The prebuilt release binary. After publishing a release, bump pkgver,
# then run `updpkgsums && makepkg --printsrcinfo > .SRCINFO`.
pkgname=difftower-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="A control tower for coding agents: live diff, protected files and tests, locally or over SSH"
arch=('x86_64')
url="https://difftower.com"
license=('MIT OR Apache-2.0')
depends=('git' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'vulkan-icd-loader' 'wayland' 'fontconfig')
optdepends=('openssh: open repositories on other machines'
            'libnotify: desktop notifications')
provides=('difftower')
conflicts=('difftower')
options=('!strip' '!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/a-gracia/difftower/releases/download/v$pkgver/difftower-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('SKIP')

package() {
    cd difftower-x86_64-unknown-linux-gnu
    install -Dm755 difftower "$pkgdir/usr/bin/difftower"
    install -Dm644 difftower.desktop "$pkgdir/usr/share/applications/difftower.desktop"
    install -Dm644 difftower.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/difftower.svg"
    install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname/"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
